#!/bin/bash
# Sync AP band and channel to STA
# Handles DFS channels by mapping to nearest non-DFS alternative

IFACE="$1"
EVENT="$2"
AP_CON="PI_AGER_AP"

LOGFILE="/var/log/98-sync-ap-channel.log"

log() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') $1" | tee -a "$LOGFILE"
    logger -t 98-sync-ap-channel "$1"
}

# Non-DFS 5 GHz channels only
NON_DFS_CHANNELS=(36 40 44 48 149 153 157 161 165)

is_dfs_channel() {
    local ch=$1
    # DFS range: 52–140
    if [ "$ch" -ge 52 ] && [ "$ch" -le 140 ]; then
        return 0  # true, is DFS
    fi
    return 1  # false, not DFS
}

nearest_non_dfs() {
    local ch=$1
    local best_ch=36
    local best_dist=9999

    for safe in "${NON_DFS_CHANNELS[@]}"; do
        dist=$(( ch - safe ))
        dist=${dist#-}   # absolute value
        if [ "$dist" -lt "$best_dist" ]; then
            best_dist=$dist
            best_ch=$safe
        fi
    done
    echo "$best_ch"
}

if [ "$EVENT" = "up" ] && [ "$IFACE" = "wlan0" ]; then

    # Read STA channel and frequency
    CHANNEL=$(iw dev wlan0 info | awk '/channel/ {print $2}')
    FREQ=$(iw dev wlan0 info | awk '/channel/ {print $3}' | tr -d '(')

    if [ -z "$CHANNEL" ] || [ -z "$FREQ" ]; then
        log "Could not read channel/freq — aborting"
        exit 1
    fi

    # Derive band
    if [ "$FREQ" -ge 5000 ]; then
        REQUIRED_BAND="a"
    else
        REQUIRED_BAND="bg"
    fi

    # Handle DFS channel substitution
    AP_CHANNEL="$CHANNEL"
    if [ "$REQUIRED_BAND" = "a" ] && is_dfs_channel "$CHANNEL"; then
        AP_CHANNEL=$(nearest_non_dfs "$CHANNEL")
        log "ch=${CHANNEL} is DFS — substituting ch=${AP_CHANNEL}"
    fi

    # Read current AP config
    CURRENT_BAND=$(nmcli -g 802-11-wireless.band con show "$AP_CON")
    CURRENT_CHANNEL=$(nmcli -g 802-11-wireless.channel con show "$AP_CON")

    log "STA=${FREQ}MHz ch=${CHANNEL} → AP target: band=${REQUIRED_BAND} ch=${AP_CHANNEL} | AP now: band=${CURRENT_BAND} ch=${CURRENT_CHANNEL}"

    if [ "$CURRENT_BAND" != "$REQUIRED_BAND" ] || [ "$CURRENT_CHANNEL" != "$AP_CHANNEL" ]; then
        log "Change detected — updating AP"

        # Set band and channel atomically
        nmcli con mod "$AP_CON" wifi.band "$REQUIRED_BAND" wifi.channel "$AP_CHANNEL"

        if [ $? -ne 0 ]; then
            log "nmcli con mod failed — aborting"
            exit 1
        fi

        nmcli con down "$AP_CON"
        sleep 2
        nmcli con up   "$AP_CON"

        log "AP restarted on band=${REQUIRED_BAND} ch=${AP_CHANNEL}"
    else
        log "No change — AP restart skipped"
    fi
fi