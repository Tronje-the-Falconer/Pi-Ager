#!/bin/bash
#
# rc.local — runs before NetworkManager takes over


# Print the IP address
_IP=$(hostname -I) || true
if [ "$_IP" ]; then
  echo "My IP address is $_IP" | systemd-cat -t rc.local
fi

rfkill unblock wifi
sleep 1

# Step 1: Create virtual AP interface
iw dev wlan0 interface add wlan1 type __ap

# Step 2: Verify wlan1 was created
if ! ip link show wlan1 &>/dev/null; then
    echo "rc.local ERROR: wlan1 not created" | systemd-cat -t rc.local
    exit 1
fi

# Step 3: Set locally-administered MAC on wlan1
WLAN0_MAC=$(cat /sys/class/net/wlan0/address)
FIRST_BYTE=$(echo "$WLAN0_MAC" | cut -d: -f1)
NEW_FIRST=$(printf "%02x" $(( (0x${FIRST_BYTE} | 0x02) ^ 0x08 )))
AP_MAC="${NEW_FIRST}:$(echo "$WLAN0_MAC" | cut -d: -f2-)"
ip link set wlan1 address "$AP_MAC"

# Step 4: Bring wlan1 up
# ip link set wlan1 up

# Step 5: Set band and channel on wlan1 before NM starts
# Use a safe non-DFS channel — NM/AP will inherit this
iw dev wlan1 set channel 6
sleep 1
# In NM profile — enforce on activation
nmcli con mod "PI_AGER_AP" wifi.band bg wifi.channel 6

sleep 1

# Step 6: Disable power save on both interfaces
iw dev wlan0 set power_save off
iw dev wlan1 set power_save off

echo "rc.local: wlan1 ready on ch6, power save off" | systemd-cat -t rc.local

if [ -f "/usr/bin/nodogsplash" ]; then
    # enable captive portal
    nodogsplash
else
    echo "nodogsplash existiert nicht." | systemd-cat -t rc.local
fi


exit 0
